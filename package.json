{
  "name": "fitstack",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @fitstack/api",
    "dev:web": "npm run dev -w @fitstack/web",
    "build": "npm run build --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @fitstack/api",
    "db:generate": "npm run db:generate -w @fitstack/api",
    "db:seed": "npm run db:seed -w @fitstack/api"
  },
  "engines": {
    "node": ">=20"
  }
}
